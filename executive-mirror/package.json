{
  "name": "executive-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Private bilingual AI executive communication and high-stakes conversation coach",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
