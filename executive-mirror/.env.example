# Executive Mirror — provider configuration
# Copy to .env.local. NEVER commit a filled-in copy. (V2 §34, §45.7)
#
# With no keys set, the app runs on mock providers: the full journey works
# end-to-end (transcript, metrics, evaluation, retry, comparison) but the voice
# is silent and the evaluation is scripted. Set keys to go live.

# --- Speech to text (live path) -------------------------------------------
DEEPGRAM_API_KEY=
EM_STT_MODEL=nova-3

# --- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Live persona turn — latency-critical, runs at low effort.
EM_LLM_MODEL=claude-opus-5
# Analysis passes — quality-critical, runs at high effort.
EM_ANALYSIS_MODEL=claude-opus-5

# --- Text to speech -------------------------------------------------------
ELEVENLABS_API_KEY=
EM_TTS_MODEL=eleven_flash_v2_5
# Voice IDs per language. Arabic is first-class — pick a voice that reads as a
# senior GCC professional, not a newsreader.
EM_TTS_VOICE_EN=
EM_TTS_VOICE_AR=

# --- Storage --------------------------------------------------------------
# Omit for the embedded PGlite dev database (.pglite/).
DATABASE_URL=

# --- Behaviour ------------------------------------------------------------
# Force mock providers regardless of keys above.
# EM_PROVIDERS=mock
# Raw audio retention. Transcripts are kept longer for longitudinal analysis.
EM_AUDIO_RETENTION_DAYS=30
