import streamlit as st
import pandas as pd
import plotly.express as px
import requests
import io

st.set_page_config(page_title="لوحة تحكم المشروع", page_icon="📊", layout="wide")

st.markdown("""
    <style>
    .block-container { direction: rtl; font-family: sans-serif; }
    h1, h2, h3, h4, h5, h6, p, div { text-align: right; }
    .stMetric { background-color: #f8f9fa; padding: 20px; border-radius: 10px; border: 1px solid #e9ecef; }
    </style>
""", unsafe_allow_html=True)

st.title("📊 لوحة القيادة التنفيذية - مشروع استيراد المعدات")
st.markdown("---")

@st.cache_data(ttl=30)
def load_data():
    # الرابط مع إضافة أمر التحميل وتخطي الحماية
    url = "https://1drv.ms/x/c/89cd6b455d2cc55f/IQBrnOctkqQvR5vFKR5YuOV0AXLmiorWTvbIypfkkIpVpJk?download=1"
    headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36'}
    try:
        response = requests.get(url, headers=headers)
        response.raise_for_status()
        
        df_partners = pd.read_excel(response.content, sheet_name='سجل الشركاء')
        df_inventory = pd.read_excel(response.content, sheet_name='سجل المخزون')
        df_sales = pd.read_excel(response.content, sheet_name='سجل المبيعات')
        return df_partners, df_inventory, df_sales
    except Exception as e:
        st.error(f"⚠️ خطأ في الاتصال بملف الإكسيل: {e}")
        return None, None, None

df_partners, df_inventory, df_sales = load_data()

if df_partners is not None:
    df_sales_clean = df_sales[pd.to_numeric(df_sales['سعر البيع النهائي'], errors='coerce') > 0]

    total_capital = 287550
    total_collected = df_partners['المسدد (SAR)'].sum()
    total_remaining = total_capital - total_collected
    total_sales = df_sales_clean['سعر البيع النهائي'].sum() if not df_sales_clean.empty else 0
    total_profit = df_sales_clean['ربح الشركاء الصافي'].sum() if not df_sales_clean.empty else 0

    col1, col2, col3, col4 = st.columns(4)
    with col1: st.metric("💰 إجمالي رأس المال", f"{total_capital:,.0f} ر.س")
    with col2: st.metric("✅ إجمالي المحصل", f"{total_collected:,.0f} ر.س")
    with col3: st.metric("⏳ العجز المتبقي", f"{total_remaining:,.0f} ر.س")
    with col4: st.metric("📈 إجمالي المبيعات", f"{total_sales:,.0f} ر.س")

    st.markdown("<br>", unsafe_allow_html=True)
    col_chart1, col_chart2 = st.columns(2)

    with col_chart1:
        st.subheader("تحليل سداد الشركاء")
        fig_partners = px.bar(df_partners, x='اسم الشريك', y=['المسدد (SAR)', 'الرصيد المتبقي عليه (SAR)'], color_discrete_map={'المسدد (SAR)': '#2E7D32', 'الرصيد المتبقي عليه (SAR)': '#D32F2F'})
        st.plotly_chart(fig_partners, use_container_width=True)

    with col_chart2:
        st.subheader("حالة المخزون الفعلي")
        df_inv_filtered = df_inventory[pd.to_numeric(df_inventory['المخزون المتبقي'], errors='coerce') > 0]
        fig_inv = px.pie(df_inv_filtered, names='المعدة', values='المخزون المتبقي', hole=0.45)
        st.plotly_chart(fig_inv, use_container_width=True)
